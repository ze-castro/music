# SQLite file path (directory is created if missing)
DATABASE_URL=./data/music.db
# 32 bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Any long random string. Generate: openssl rand -base64 48
SESSION_SECRET=
# Pin the Navidrome URL; login form then only asks user/pass. Required in production.
NAVIDROME_URL=
# Set to true to let the login form accept any server URL (unsafe on a public instance)
ALLOW_ANY_SERVER=
# Prod only: public URL of this app
ORIGIN=